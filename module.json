	"flags": {
		"pf2e-soldiers-of-the-immortal-war": {
			"pf2e-homebrew": {
				"classTraits": {
					"inquisitor": "Inquisitor"
				},
				"featTraits": {
					"consigned": {
						"label": "Consigned",
						"description": "Consigned feats can typically be taken as class feats, though some are general or skill feats. If a consigned feat isn’t a general or skill feat, the feat gains the appropriate trait for the class of the character who selected it. Most consigned feats require you to already have at least one consignment feat. Some consigned feats however, such as Celestial Heart, act as a method of gaining your first consignment feat and can be taken as long as you have a patron that meets the prerequisites."
					},
					"consignment": {
						"label": "Consignment",
						"description": "Certain feats may align you with powers even more than normal for creatures, selling away your soul to these powers for greater gains. These feats have the consignment trait. You cannot retrain out of feats with the consignment trait short of divine intervention, often requiring you to beseech the powers you sold your soul to for mercy. Gaining consignment feats is not inherently bad, however; many heralds of benevolent deities have the benefits of several consignment feats. Consigning yourself simply means binding yourself to their service for all eternity, something that can be a great boon to many creatures."
					},
					"inquisitor": "Inquisitor",
					"justice": {
						"label": "Justice",
						"description": "Actions and spells with the justice trait are blessed by your deity’s divine providence. Their usage functions as a trigger for your righteous acts."
					},
					"righteous": {
						"label": "Righteous",
						"description": "Actions with this trait allow you to follow up on your deity’s divine energy. An action with the righteous trait can be used only if your previous action had the justice trait, including Casting a Spell with the justice trait. You can only use one action with the righteous trait per round, and can only use actions with the righteous trait while within 30 feet of a target of your Judgment."
					}
				},
				"spellTraits": {
					"inquisitor": "Inquisitor",
					"justice": {
						"label": "Justice",
						"description": "Actions and spells with the justice trait are blessed by your deity’s divine providence. Their usage functions as a trigger for your righteous acts."
					}
				}
			}
		}
	}
